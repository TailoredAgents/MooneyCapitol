# Core
STATE_STORE=db
DEPTH_MODE=demo
TRADES_DEMO=1
DATABASE_URL=postgresql://user:pass@localhost:5432/trading_agent
OPENAI_API_KEY=
OPENAI_AI_FEATURES_ENABLED=0
OPENAI_RESEARCH_ENABLED=0
OPENAI_DAILY_REQUEST_LIMIT=200
OPENAI_RESEARCH_DAILY_REQUEST_LIMIT=30
OPENAI_SCOUT_EXPLANATION_MODEL=gpt-5.4-mini
OPENAI_DAILY_RECAP_MODEL=gpt-5.4
OPENAI_LEARNING_TRANSLATION_MODEL=gpt-5.4-mini
OPENAI_TRADE_JOURNAL_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_MODEL=gpt-5.5
POLYGON_API_KEY=
SENTRY_DSN=

# Slack
SLACK_CHANNEL=all-trading
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# IBKR Depth Provider
IBKR_HOST=
IBKR_PORT=7497
IBKR_CLIENT_ID=123
IBKR_USERNAME=
IBKR_TRADE_MODE=paper
IBKR_SMART_DEPTH=1
IBKR_DEPTH_LEVELS=5

# Legacy/demo fill ingestion
TS_CLIENT_ID=
TS_CLIENT_SECRET=
TS_REFRESH_TOKEN=

# Legacy V1 equity/Webull reference only. The primary V2 dashboard and Rithmic
# capture service do not read these values. Keep the deny-only gates disabled.
COPIER_ENABLED=0
COPIER_MODE=test
WEBULL_MASTER_API_ENDPOINT=
WEBULL_MASTER_EVENTS_ENDPOINT=
WEBULL_MASTER_APP_KEY=
WEBULL_MASTER_APP_SECRET=
WEBULL_MASTER_ACCOUNT_ID=
# Base directory for reusable Webull 2FA tokens. Use a persistent Render disk
# path in production so authorization survives deploys and service restarts.
WEBULL_OPENAPI_TOKEN_DIR=conf/webull_tokens
# Optional fallback only; normal copier sizing uses latest Webull P&L snapshot equity.
WEBULL_MASTER_ACCOUNT_EQUITY=
WEBULL_PERSONAL_API_ENDPOINT=
WEBULL_PERSONAL_APP_KEY=
WEBULL_PERSONAL_APP_SECRET=
WEBULL_PERSONAL_ACCOUNT_ID=
# Optional fallback only; normal copier sizing uses latest Webull P&L snapshot equity.
WEBULL_PERSONAL_ACCOUNT_EQUITY=

# Learning
LEARNING_XGB_MIN_ROWS=20
LEARNING_MANUAL_MATCH_WINDOW_MINUTES=30
LEARNING_MATCH_PRE_ALERT_SECONDS=60
LEARNING_MATCH_MIN_CONFIDENCE=likely
LEARNING_BEHAVIOR_WEIGHT=0.35
LEARNING_OUTCOME_WEIGHT=0.50
LEARNING_MANUAL_EDGE_WEIGHT=0.15
LEARNING_PENALTY_WEIGHT=0.10
LEARNING_SANDBOX_ENABLED=0
LEARNING_SYNTHETIC_MAX_RATIO=3.0
LEARNING_SYNTHETIC_SAMPLE_WEIGHT=0.15
LEARNING_PAPER_SAMPLE_WEIGHT=0.25
TRADE_MATCH_WINDOW_SECONDS=1800
TRADE_MATCH_PRE_ALERT_SECONDS=60
TRADE_MATCH_MIN_CONFIDENCE=likely
SHADOW_TRADER_ENABLED=0
SHADOW_TRADER_MIN_P2R=0.70
SHADOW_TRADER_MIN_RR=2.00
SHADOW_TRADER_SIZE_PCT=0.05
AI_LAB_ENABLED=0
AI_LAB_STARTING_EQUITY=100000
AI_LAB_BUYING_POWER_MULTIPLIER=4.00
AI_LAB_SIZE_PCT=0.05
# Legacy aliases kept for compatibility.
PAPER_TRADER_ENABLED=0
PAPER_TRADER_BROKER_MODE=internal
PAPER_TRADER_ACCOUNT_EQUITY=10000
PAPER_TRADER_SIZE_PCT=0.05
PAPER_PROMOTION_MIN_CLOSED_TRADES=50
PAPER_PROMOTION_MIN_TRADING_DAYS=3
PAPER_PROMOTION_MIN_WIN_RATE=0.55
PAPER_PROMOTION_MIN_AVG_R=0.20
PAPER_PROMOTION_MAX_DRAWDOWN_PCT=0.10
# Legacy V1 broker-paper adapter only; the active V2 deployment leaves these unset.
WEBULL_AI_PAPER_API_ENDPOINT=
WEBULL_AI_PAPER_EVENTS_ENDPOINT=
WEBULL_AI_PAPER_APP_KEY=
WEBULL_AI_PAPER_APP_SECRET=
WEBULL_AI_PAPER_ACCOUNT_ID=
WEBULL_AI_PAPER_DISPLAY_NAME=Austin Webull Paper Account

# Operator authentication
# Set BOTH username and password to lock /dashboard behind the operator login.
# Set the API token to require X-Operator-Token on protected APIs, including
# /v2/operations/* and /copier/*. A dashboard browser session is also accepted,
# so the dashboard works without a separate token. Leave any unset to keep that
# auth path open (local development and tests only).
COWORK_OPERATOR_USERNAME=
COWORK_OPERATOR_PASSWORD=
COWORK_OPERATOR_API_TOKEN=
# Optional URL used by the primary dashboard for sanitized live capture health.
# Durable observations still load from Postgres when this is unset.
RITHMIC_CAPTURE_BASE_URL=
RITHMIC_CAPTURE_HEALTH_TIMEOUT_SECONDS=2

# Rithmic read-only capture (fail-closed defaults)
# Connectivity is allowed only when this is 1 AND RITHMIC_ENVIRONMENT=TEST.
RITHMIC_CAPTURE_CONNECTIVITY_ENABLED=0
RITHMIC_ENVIRONMENT=DISABLED
RITHMIC_ENABLED_PLANTS=ORDER,PNL
# Comma-separated opaque broker account IDs. Required before connectivity.
RITHMIC_ACCOUNT_ALLOWLIST=
RITHMIC_DISCOVERY_URI=
RITHMIC_SYSTEM_NAME=
# If discovery returns more than one gateway, select one explicitly. Per-plant
# WSS URI/name overrides are optional troubleshooting controls.
RITHMIC_GATEWAY_NAME=
RITHMIC_ORDER_GATEWAY_NAME=
RITHMIC_PNL_GATEWAY_NAME=
RITHMIC_TICKER_GATEWAY_NAME=
RITHMIC_ORDER_URI=
RITHMIC_PNL_URI=
RITHMIC_TICKER_URI=
RITHMIC_USERNAME=
RITHMIC_PASSWORD=
RITHMIC_APPLICATION_NAME=MooneyCapitol
RITHMIC_APPLICATION_VERSION=v2-read-only
RITHMIC_TEMPLATE_VERSION=5.55
# Choose exactly one runtime source. All files must stay outside this repo.
RITHMIC_GENERATED_BINDINGS_PATH=
RITHMIC_GENERATED_BINDINGS_ARCHIVE=
RITHMIC_GENERATED_BINDINGS_ARCHIVE_B64_FILE=
# Required for either archive source; SHA-256 of the binary ZIP, not the base64 file.
RITHMIC_GENERATED_BINDINGS_SHA256=
RITHMIC_CA_FILE=
# Production read-only factories. Paths outside app.v2 are rejected.
RITHMIC_CAPTURE_OBSERVER_FACTORY=app.v2.brokers.rithmic_protocol.adapter:create_observer
RITHMIC_CAPTURE_JOURNAL_FACTORY=app.v2.capture.persistence:create_journal
RITHMIC_CAPTURE_POLL_SECONDS=1
RITHMIC_LOGIN_TIMEOUT_SECONDS=30
RITHMIC_REQUEST_TIMEOUT_SECONDS=30
RITHMIC_RECONCILIATION_TIMEOUT_SECONDS=120
RITHMIC_MAX_BUFFERED_EVENTS=50000
# Optional authenticated operational reference queries. Keep disabled for
# normal ORDER+PNL capture. The token must be a random 32-512 character secret.
RITHMIC_REFERENCE_QUERY_ENABLED=0
RITHMIC_REFERENCE_QUERY_TOKEN=
RITHMIC_REFERENCE_QUERY_TIMEOUT_SECONDS=15
RITHMIC_REFERENCE_QUERY_MAX_RESULTS=50
# Non-negative epoch seconds used by official account/user metadata playback.
# Keep 0 unless a later bounded value is proven to retain authoritative state.
RITHMIC_ACCOUNT_METADATA_START_SSBOE=0
# Optional YYYYMMDD overrides; blank uses the current/recent CME trade date.
RITHMIC_RECOVERY_TRADE_DATE=
RITHMIC_FILL_HISTORY_START_INDEX=
RITHMIC_FILL_HISTORY_FINISH_INDEX=
