# Operator authentication
# Set BOTH username and password to lock /dashboard behind HTTP Basic Auth.
# Set the API token to require X-Operator-Token on /copier/* APIs and
# /config PUT. A dashboard browser session with the basic credentials is
# also accepted on /copier APIs, so the dashboard works without a separate
# token. Leave any unset to keep that auth path open (local dev / tests).
COWORK_OPERATOR_USERNAME=
COWORK_OPERATOR_PASSWORD=
COWORK_OPERATOR_API_TOKEN=
