# Core
STATE_STORE=db
DEPTH_MODE=demo
TRADES_DEMO=1
DATABASE_URL=postgresql://user:pass@localhost:5432/trading_agent
OPENAI_API_KEY=
POLYGON_API_KEY=
SENTRY_DSN=

# Slack
SLACK_CHANNEL=all-trading
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# IBKR Depth Provider
IBKR_HOST=
IBKR_PORT=7497
IBKR_CLIENT_ID=123
IBKR_USERNAME=
IBKR_TRADE_MODE=paper
IBKR_SMART_DEPTH=1
IBKR_DEPTH_LEVELS=5

# Legacy/demo fill ingestion
TS_CLIENT_ID=
TS_CLIENT_SECRET=
TS_REFRESH_TOKEN=

# Copier
COPIER_ENABLED=0
COPIER_MODE=test
WEBULL_MASTER_API_ENDPOINT=
WEBULL_MASTER_APP_KEY=
WEBULL_MASTER_APP_SECRET=
WEBULL_MASTER_ACCOUNT_ID=
WEBULL_MASTER_ACCOUNT_EQUITY=
WEBULL_PERSONAL_API_ENDPOINT=
WEBULL_PERSONAL_APP_KEY=
WEBULL_PERSONAL_APP_SECRET=
WEBULL_PERSONAL_ACCOUNT_ID=
WEBULL_PERSONAL_ACCOUNT_EQUITY=

# Learning
LEARNING_XGB_MIN_ROWS=20
LEARNING_MANUAL_MATCH_WINDOW_MINUTES=30
LEARNING_BEHAVIOR_WEIGHT=0.35
LEARNING_OUTCOME_WEIGHT=0.50
LEARNING_MANUAL_EDGE_WEIGHT=0.15
LEARNING_PENALTY_WEIGHT=0.10
LEARNING_SANDBOX_ENABLED=0
LEARNING_SYNTHETIC_MAX_RATIO=3.0
LEARNING_SYNTHETIC_SAMPLE_WEIGHT=0.15

# Operator authentication
# Set BOTH username and password to lock /dashboard behind HTTP Basic Auth.
# Set the API token to require X-Operator-Token on /copier/* APIs and
# /config PUT. A dashboard browser session with the basic credentials is
# also accepted on /copier APIs, so the dashboard works without a separate
# token. Leave any unset to keep that auth path open (local dev / tests).
COWORK_OPERATOR_USERNAME=
COWORK_OPERATOR_PASSWORD=
COWORK_OPERATOR_API_TOKEN=
